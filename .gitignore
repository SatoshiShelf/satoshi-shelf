# Private paid product files — must NEVER be committed to the public repo.
# They are embedded into the Cloudflare Worker at deploy time instead.
products/

# Worker build output + local secrets/deps
worker/src/embedded.js
worker/.shelfkey
worker/node_modules/
worker/.wrangler/
worker/.dev.vars

# OS cruft
.DS_Store

worker/embedded.js

worker/deliveries.local.json

# Encrypted deliverables catalog.
# The Worker embeds its own copy at deploy time, so this never needs to be
# published. Kept local only (it is a mirror of every paid file's ciphertext).
secure/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Cloudflare Pages/Workers static publish dir
dist/

# Build inputs that must never be published
_headers
