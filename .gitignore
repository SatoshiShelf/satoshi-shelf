# ---------------------------------------------------------------------------
# GitHub Pages publishes every non-ignored file at the repo root.
# Everything below stays OUT of the repo so it can never be fetched from the web.
# ---------------------------------------------------------------------------

# Private paid deliverables (plaintext) — embedded into the Worker at deploy time.
products/

# Internal source / build inputs / notes
_src/
_headers
dist/
worker/
secure/

# Worker build output + local secrets/deps
worker/src/embedded.js
worker/.shelfkey
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
worker/embedded.js
worker/deliveries.local.json

# Wrangler / env
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# OS cruft
.DS_Store

# This repo is now REDIRECT STUBS ONLY for the old /satoshi-shelf/ path.
# The live storefront is served from https://satoshishelf.github.io/ (the
# SatoshiShelf.github.io repo). Publishing assets here would re-create the
# duplicate content the migration removed, so they stay untracked.
assets/
previews/
