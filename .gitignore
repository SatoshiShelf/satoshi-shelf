# Private paid product files — must NEVER be committed to the public repo.
# They are embedded into the Cloudflare Worker at deploy time instead.
products/

# Worker build output + local secrets/deps
worker/src/embedded.js
worker/.shelfkey
worker/node_modules/
worker/.wrangler/
worker/.dev.vars

# OS cruft
.DS_Store

worker/embedded.js

worker/deliveries.local.json

# secure/ holds AES-256-GCM encrypted deliverables — safe to commit (useless
# without the private key held only by the deployed Worker).
!secure/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Cloudflare Pages/Workers static publish dir
dist/
